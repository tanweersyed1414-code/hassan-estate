# --- Database (required) ---
DATABASE_URL="postgresql://user:password@localhost:5432/hassan_estates"

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- AI Assistant (optional) ---
# Without this, the assistant uses a safe database-grounded fallback responder.
OPENAI_API_KEY=""

# --- Google sign-in for public visitors (property visit booking) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Redirect URI: https://<your-domain>/api/auth/callback/google (+ http://localhost:3000/... for dev)
# Booking a property visit requires the visitor to be signed in; without these the
# "Sign in with Google" button is hidden.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Transactional email (visit confirmations) ---
# https://resend.com -> API Keys. Without it, status changes still work but no
# email is sent. VISIT_FROM_EMAIL needs a domain verified in Resend; until then
# leave it blank to use Resend's shared test sender.
RESEND_API_KEY=""
VISIT_FROM_EMAIL=""

# --- Image storage (optional) ---
# Without these, uploads are stored locally under /public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Maps (optional) ---
# Without this, property locations use a keyless Google Maps embed.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Public site info ---
NEXT_PUBLIC_SITE_URL="https://www.hassanestates.pk"
NEXT_PUBLIC_WHATSAPP_NUMBER="923318987584"
NEXT_PUBLIC_PHONE_NUMBER="+923318987584"

# --- Initial admin account created by the seed script ---
SEED_ADMIN_EMAIL="admin@hassanestates.pk"
SEED_ADMIN_PASSWORD="ChangeMe!123"
